<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer" (paste it in SignPath: Project > Artifact configurations > installer).
  The release workflow uploads one zip with CleanSuite-Setup-<version>.exe, built from the programs signed with "programs".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="CleanSuite-Setup-${version}.exe" product-name="CleanSuite" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
