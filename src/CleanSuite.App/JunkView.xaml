<UserControl x:Class="CleanSuite.App.JunkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CleanSuite.App.Localization"
             xmlns:theming="clr-namespace:CleanSuite.App.Theming">
    <!-- Junk files: choose drives, folders and options, scan (read-only), review, remove the checked files. State in JunkViewModel. -->
    <UserControl.Resources>
        <CollectionViewSource x:Key="RowsView">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupTitle" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
        <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Margin="0,0,0,10">
            <!-- Wraps onto a second line when the window is narrow. -->
            <WrapPanel>
                <WrapPanel Margin="0,0,12,0">
                    <Button x:Name="ScanButton" Content="{loc:T Scan}" Command="{Binding ScanCommand}" Style="{StaticResource AccentButton}" />
                    <Button x:Name="CancelButton" Content="{loc:T Cancel}" Command="{Binding CancelCommand}" />
                    <Rectangle Style="{StaticResource ToolbarSeparator}" />
                    <TextBlock Text="{loc:T RemovalLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="RemovalCombo" AutomationProperties.Name="{loc:T RemovalLabel}" MinWidth="180" VerticalAlignment="Center" Margin="0,0,6,0" SelectedIndex="0">
                        <ComboBoxItem Content="{loc:T RemovalRecycle}" Tag="RecycleBin" />
                        <ComboBoxItem Content="{loc:T RemovalZip}" Tag="ZipBackup" />
                        <ComboBoxItem Content="{loc:T RemovalPermanent}" Tag="Permanent" />
                    </ComboBox>
                    <Button x:Name="CleanButton" Content="{loc:T CleanSelected}" Command="{Binding CleanCommand}" />
                    <Rectangle Style="{StaticResource ToolbarSeparator}" />
                    <Button Content="{loc:T RestoreBackup}" Click="Restore_Click" />
                </WrapPanel>

            </WrapPanel>
        </Border>

        <!-- Options -->
        <Expander x:Name="ScanOptionsExpander" DockPanel.Dock="Top" Header="{loc:T ScanOptions}" IsExpanded="True" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" theming:Fit.MaxHeightShare="0.4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{loc:T Drives}" Grid.Row="0" Margin="0,4,14,0" Style="{StaticResource LabelText}" VerticalAlignment="Top" />
                    <ItemsControl x:Name="DrivesList" Grid.Row="0" Grid.Column="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Separate elements instead of bidi control characters, which WPF's text engine ignores. -->
                                <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FlowDirection="LeftToRight" />
                                        <TextBlock Text=" — " />
                                        <TextBlock Text="{Binding Free}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:T Folders}" Grid.Row="1" Margin="0,8,14,0" Style="{StaticResource LabelText}" VerticalAlignment="Top" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="{loc:T Remove}" Click="RemoveFolder_Click" Margin="0" VerticalAlignment="Top" />
                        <Button DockPanel.Dock="Right" Content="{loc:T AddFolder}" Click="AddFolder_Click" VerticalAlignment="Top" />
                        <ListBox x:Name="FoldersList" MinHeight="50" MaxHeight="120" Margin="0,0,6,0" SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource PathCell}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <TextBlock Text="{loc:T Options}" Grid.Row="2" Margin="0,10,14,0" Style="{StaticResource LabelText}" VerticalAlignment="Top" />
                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                        <CheckBox x:Name="OptTemp" Content="{loc:T OptTemp}" IsChecked="True" />
                        <CheckBox x:Name="OptZero" Content="{loc:T OptZero}" />
                        <CheckBox x:Name="OptIgnore" Content="{loc:T OptIgnore}" IsChecked="True" />
                        <CheckBox x:Name="OptEmptyTemp" Content="{loc:T OptEmptyTemp}" IsChecked="True" />
                        <CheckBox x:Name="OptRecent" Content="{loc:T OptRecent}" />
                        <CheckBox x:Name="OptTempAllIgnores" Content="{loc:T OptTempAllIgnores}" ToolTip="{loc:T OptTempAllIgnoresTip}" />
                    </WrapPanel>

                    <TextBlock x:Name="SettingsInfo" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </Grid>
            </ScrollViewer>
        </Expander>

        <!-- Status bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="{loc:T CheckAll}" Command="{Binding SelectAllCommand}" />
                <Button Content="{loc:T UncheckAll}" Command="{Binding SelectNoneCommand}" />
                <Button Content="{loc:T Invert}" Command="{Binding InvertCommand}" />
            </StackPanel>
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="160" Height="6" Margin="8,0,0,0" Visibility="Hidden" IsIndeterminate="True" />
            <TextBlock theming:Live.Announce="True" x:Name="StatusText" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Results -->
        <DataGrid x:Name="ResultsGrid" theming:Empty.Text="{loc:T EmJunk}" ItemsSource="{Binding Source={StaticResource RowsView}}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" SizeChanged="ResultsGrid_SizeChanged">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="SemiBold" Margin="6,8,6,4" Foreground="{DynamicResource AccentBg}">
                                <Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding Item.FullPath}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}">
                    <MenuItem Header="{loc:T MenuOpenFolder}" Click="OpenFolder_Click" />
                    <MenuItem Header="{loc:T MenuCheckHighlighted}" Click="CheckHighlighted_Click" />
                    <MenuItem Header="{loc:T MenuUncheckHighlighted}" Click="UncheckHighlighted_Click" />
                    <Separator />
                    <MenuItem Header="{loc:T MenuExcludeAlways}" Click="ExcludeAlways_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Item.FullPath}"
                                      HorizontalAlignment="Center" Margin="0"
                                      IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource Not}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:T ColName}" Binding="{Binding Name}" Width="Auto" MinWidth="140" MaxWidth="320" IsReadOnly="True"
                                    ElementStyle="{StaticResource PathCell}" />
                <!-- Width is set from code (FitFolderColumn): a "*" column collapses all columns when rows are grouped. -->
                <DataGridTextColumn x:Name="FolderColumn" Header="{loc:T ColFolder}" Binding="{Binding Folder}" Width="300" IsReadOnly="True"
                                    ElementStyle="{StaticResource PathCell}" />
                <DataGridTextColumn Header="{loc:T ColSize}" Binding="{Binding SizeText}" Width="Auto" MinWidth="80" IsReadOnly="True"
                                    SortMemberPath="SizeKb">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{loc:T ColType}" Binding="{Binding Category}" Width="Auto" MinWidth="80" IsReadOnly="True" />
                <DataGridTextColumn Header="{loc:T ColReason}" Binding="{Binding Reason}" Width="Auto" MinWidth="120" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
        
</UserControl>
