<UserControl x:Class="CleanSuite.App.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CleanSuite.App.Localization"
             xmlns:theming="clr-namespace:CleanSuite.App.Theming">
    <UserControl.Resources>
        <DataTemplate x:Key="ShareCell">
            <Grid Margin="2,3">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="16" />
                <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
            </Grid>
        </DataTemplate>
        <!-- Legend row of a chart: colour, name, size and share (the chart is never read from colour alone). -->
        <DataTemplate x:Key="LegendRow">
            <Grid Margin="0,3" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Fill}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource PathCell}" />
                <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource MutedText}" MinWidth="52" TextAlignment="Right"
                           Margin="10,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight" />
            </Grid>
        </DataTemplate>
        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,8,8,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Margin="0,0,0,10">
            <WrapPanel>
                <ComboBox x:Name="TargetCombo" AutomationProperties.Name="{loc:T DaTarget}" Width="230" />
                <Button x:Name="AddFolderButton" Content="{loc:T AddFolder}" Click="AddFolder_Click" />
                <Button x:Name="AnalyzeButton" Content="{loc:T DaAnalyze}" Click="Analyze_Click" Style="{StaticResource AccentButton}" />
                <Button x:Name="CancelButton" Content="{loc:T Cancel}" Click="Cancel_Click" IsEnabled="False" />
                <Button x:Name="OpenButton" Content="{loc:T DaOpen}" Click="Open_Click" IsEnabled="False" />
                <Button x:Name="DeleteButton" Content="{loc:T DaDelete}" Click="Delete_Click" IsEnabled="False" />
                <Button x:Name="ReportButton" Content="{loc:T DaReport}" Click="Report_Click" IsEnabled="False" />
            </WrapPanel>
        </Border>

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10"
                      theming:Fit.MaxHeightShare="0.28">
        <ItemsControl x:Name="DrivesList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6" Margin="0,0,8,8" Width="285">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Height="8" Margin="0,4" />
                            <TextBlock Text="{Binding UsedText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FreeText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>

        <TextBlock theming:Live.Announce="True" x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="180" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="3*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" />
            <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged" />

            <TabControl x:Name="Views" Grid.Column="2">
                <TabItem Header="{loc:T DaContents}">
                    <DataGrid x:Name="ContentsGrid" theming:Empty.Text="{loc:T EmDisk}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                              SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Contents_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T ColName}" Binding="{Binding Name}" Width="*" MinWidth="150" ElementStyle="{StaticResource PathCell}" />
                            <DataGridTextColumn Header="{loc:T DaColSize}" Binding="{Binding SizeText}" Width="95" SortMemberPath="Size" />
                            <DataGridTemplateColumn Header="{loc:T DaColShare}" CellTemplate="{StaticResource ShareCell}" Width="110" SortMemberPath="Percent" />
                            <DataGridTextColumn Header="{loc:T DaColItems}" Binding="{Binding Items}" Width="70" />
                            <DataGridTextColumn Header="{loc:T DaColFiles}" Binding="{Binding Files}" Width="80" />
                            <DataGridTextColumn Header="{loc:T DaColFolders}" Binding="{Binding Folders}" Width="80" />
                            <DataGridTextColumn Header="{loc:T DaColAttrib}" Binding="{Binding Attrib}" Width="60" />
                            <DataGridTextColumn Header="{loc:T DaColModified}" Binding="{Binding ModifiedText}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{loc:T DaTypes}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="160" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="3*" MinWidth="240" />
                        </Grid.ColumnDefinitions>
                        <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" />
                        <DataGrid x:Name="CategoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                                  SelectionChanged="Category_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T DaColType}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{loc:T DaColSize}" Binding="{Binding SizeText}" Width="80" SortMemberPath="Size" />
                                <DataGridTemplateColumn Header="{loc:T DaColShare}" CellTemplate="{StaticResource ShareCell}" Width="80" SortMemberPath="Percent" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="ExtensionGrid" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T DaColExtension}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource PathCell}" />
                                <DataGridTextColumn Header="{loc:T DaColCount}" Binding="{Binding Count}" Width="90" SortMemberPath="CountValue" />
                                <DataGridTextColumn Header="{loc:T DaColSize}" Binding="{Binding SizeText}" Width="95" SortMemberPath="Size" />
                                <DataGridTemplateColumn Header="{loc:T DaColShare}" CellTemplate="{StaticResource ShareCell}" Width="110" SortMemberPath="Percent" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="{loc:T DaCharts}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid x:Name="ChartsPanel" Columns="2" VerticalAlignment="Top">
                            <Border Style="{StaticResource ChartCard}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T DaChartFolders}" Style="{StaticResource GroupTitle}" Margin="0,0,0,8" />
                                    <theming:DonutChart x:Name="FolderChart" Height="170" />
                                    <ItemsControl x:Name="FolderLegend" ItemTemplate="{StaticResource LegendRow}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChartCard}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T DaChartTypes}" Style="{StaticResource GroupTitle}" Margin="0,0,0,8" />
                                    <theming:DonutChart x:Name="TypeChart" Height="170" />
                                    <ItemsControl x:Name="TypeLegend" ItemTemplate="{StaticResource LegendRow}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{loc:T DaTop}">
                    <DataGrid x:Name="TopGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                              SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Top_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T ColName}" Binding="{Binding Name}" Width="220" ElementStyle="{StaticResource PathCell}" />
                            <DataGridTextColumn Header="{loc:T DaColLocation}" Binding="{Binding Location}" Width="*" ElementStyle="{StaticResource PathCell}" />
                            <DataGridTextColumn Header="{loc:T DaColSize}" Binding="{Binding SizeText}" Width="95" SortMemberPath="Size" />
                            <DataGridTemplateColumn Header="{loc:T DaColShare}" CellTemplate="{StaticResource ShareCell}" Width="110" SortMemberPath="Percent" />
                            <DataGridTextColumn Header="{loc:T DaColModified}" Binding="{Binding ModifiedText}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{loc:T DaEmpty}">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                            <Button x:Name="FindEmptyButton" Content="{loc:T DaFindEmpty}" Click="FindEmpty_Click" />
                            <Button x:Name="DeleteEmptyButton" Content="{loc:T DaDeleteEmpty}" Click="DeleteEmpty_Click" IsEnabled="False" />
                            <TextBlock Text="{loc:T DaEmptyNote}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                        </WrapPanel>
                        <DataGrid x:Name="EmptyGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CanUserResize="False" SortMemberPath="Selected">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Named for screen readers; not editable while the grid is read-only (a clean is running). -->
                                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                                      AutomationProperties.Name="{Binding Path}"
                                                      IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource Not}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:T ColName}" Binding="{Binding Name}" Width="220" IsReadOnly="True" ElementStyle="{StaticResource PathCell}" />
                                <DataGridTextColumn Header="{loc:T DaColLocation}" Binding="{Binding Path}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource PathCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
