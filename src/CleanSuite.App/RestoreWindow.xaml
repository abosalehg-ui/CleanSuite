<Window x:Class="CleanSuite.App.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CleanSuite.App.Localization"
        xmlns:theming="clr-namespace:CleanSuite.App.Theming"
        Style="{StaticResource AppWindow}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Title="{loc:T RestoreTitle}" Height="560" Width="980" MinHeight="380" MinWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel Margin="12">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:T RestoreBackupFile}" Style="{StaticResource LabelText}" Margin="0,0,10,4" />
            <TextBlock x:Name="FileText" Grid.Column="1" Style="{StaticResource PathCell}" Margin="0,0,0,4" HorizontalAlignment="Left" />
            <TextBlock Text="{loc:T RestoreFormat}" Grid.Row="1" Style="{StaticResource LabelText}" Margin="0,0,10,4" />
            <TextBlock x:Name="FormatText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" />
            <TextBlock theming:Live.Announce="True" x:Name="SummaryText" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" />
        </Grid>

        <!-- Options and actions -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="RestoreButton" Content="{loc:T RestoreSelected}" Click="Restore_Click" Style="{StaticResource AccentButton}" />
                <Button Content="{loc:T Close}" Click="Close_Click" IsCancel="True" Margin="0" />
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="{loc:T CheckAll}" Click="CheckAll_Click" />
                    <Button Content="{loc:T UncheckAll}" Click="UncheckAll_Click" />
                </StackPanel>
                <CheckBox x:Name="OptOverwrite" Content="{loc:T OptOverwrite}" Click="Options_Changed" />
                <DockPanel Margin="0,4,0,0">
                    <CheckBox x:Name="OptOtherFolder" Content="{loc:T OptOtherFolder}" Click="Options_Changed" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Content="{loc:T ChooseFolder}" Click="ChooseFolder_Click" />
                    <TextBox x:Name="FolderBox" AutomationProperties.Name="{loc:T OptOtherFolder}" FlowDirection="LeftToRight" MinWidth="200" Margin="0,0,6,0"
                             IsEnabled="{Binding IsChecked, ElementName=OptOtherFolder}" TextChanged="FolderBox_TextChanged" />
                </DockPanel>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding Entry.EntryName}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanRestore}" Value="False">
                            <!-- Informational text, so the muted text colour (4.5:1), not the disabled one. -->
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedFg}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRestore}"
                                      AutomationProperties.Name="{Binding DisplayPath}"
                                      HorizontalAlignment="Center" Margin="0" Click="RowCheck_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:T ColOriginalPath}" Binding="{Binding DisplayPath}" Width="3*" MinWidth="220" IsReadOnly="True"
                                    ElementStyle="{StaticResource PathCell}" />
                <DataGridTextColumn Header="{loc:T ColSize}" Binding="{Binding SizeText}" Width="Auto" MinWidth="80" IsReadOnly="True" SortMemberPath="Entry.Size"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="{loc:T ColModified}" Binding="{Binding ModifiedText}" Width="130" IsReadOnly="True"
                                    SortMemberPath="Entry.LastWriteUtc" />
                <DataGridTextColumn Header="{loc:T ColStatus}" Binding="{Binding StatusText}" Width="2*" MinWidth="120" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
