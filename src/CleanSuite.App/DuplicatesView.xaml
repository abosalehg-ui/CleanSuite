<UserControl x:Class="CleanSuite.App.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CleanSuite.App.Localization"
             xmlns:theming="clr-namespace:CleanSuite.App.Theming">
    <UserControl.Resources>
        <DataTemplate x:Key="GroupHeader">
            <TextBlock Text="{Binding Items[0].GroupTitle}" FontWeight="SemiBold" Margin="4,8,4,2" Foreground="{DynamicResource AccentBg}" />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Margin="0,0,0,10">
            <WrapPanel>
                <Button x:Name="ScanButton" Content="{loc:T DpScan}" Click="Scan_Click" Style="{StaticResource AccentButton}" />
                <Button x:Name="CancelButton" Content="{loc:T Cancel}" Click="Cancel_Click" IsEnabled="False" />
                <Button x:Name="DeleteButton" Content="{loc:T DpDelete}" Click="Delete_Click" IsEnabled="False" />
                <Button x:Name="CheckOneButton" Content="{loc:T DpCheckOne}" Click="CheckOne_Click" ToolTip="{loc:T DpCheckOneTip}" />
                <Button x:Name="UncheckAllButton" Content="{loc:T DpUncheckAll}" Click="UncheckAll_Click" />
                <TextBlock Text="{loc:T RemovalLabel}" VerticalAlignment="Center" Margin="12,0,4,0" />
                <ComboBox x:Name="RemovalCombo" AutomationProperties.Name="{loc:T RemovalLabel}" Width="230" SelectedIndex="0">
                    <ComboBoxItem Content="{loc:T RemovalRecycle}" />
                    <ComboBoxItem Content="{loc:T RemovalZip}" />
                </ComboBox>
            </WrapPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="WarningText" Foreground="{DynamicResource DangerFg}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4" />
            <TextBlock theming:Live.Announce="True" x:Name="StatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="220" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" />
            <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="10,2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:T DpWhere}" Style="{StaticResource GroupTitle}" />
                        <ItemsControl x:Name="RootsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2" AutomationProperties.Name="{Binding Path}">
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource PathCell}" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="{loc:T AddFolder}" Click="AddFolder_Click" />
                        </WrapPanel>

                        <TextBlock Text="{loc:T DpCompare}" Style="{StaticResource GroupTitle}" />
                        <CheckBox x:Name="NameBox" Content="{loc:T DpSameName}" IsChecked="True" />
                        <CheckBox x:Name="SizeBox" Content="{loc:T DpSameSize}" IsChecked="True" />
                        <CheckBox x:Name="DateBox" Content="{loc:T DpSameDate}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:T DpContent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="ContentCombo" AutomationProperties.Name="{loc:T DpContent}" Width="150" SelectedIndex="2">
                                <ComboBoxItem Content="{loc:T DpContentNone}" />
                                <ComboBoxItem Content="CRC-32" />
                                <ComboBoxItem Content="MD5" />
                            </ComboBox>
                        </StackPanel>
                        <!-- Wraps in a narrow pane: the field and its unit move under the label instead of being cut off. -->
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="MinSizeBox" Content="{loc:T DpMinSize}" IsChecked="True" VerticalAlignment="Center" />
                            <TextBox x:Name="MinSizeText" AutomationProperties.Name="{loc:T DpMinSize}" Text="1" Width="50" Margin="6,0" FlowDirection="LeftToRight" VerticalContentAlignment="Center" />
                            <ComboBox x:Name="UnitCombo" AutomationProperties.Name="{loc:T DpMinSize}" MinWidth="70" SelectedIndex="0">
                                <ComboBoxItem Content="{loc:T UnitMB}" />
                                <ComboBoxItem Content="{loc:T UnitKB}" />
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock Text="{loc:T DpFileTypes}" Style="{StaticResource GroupTitle}" />
                        <ComboBox x:Name="ProfileCombo" AutomationProperties.Name="{loc:T DpFileTypes}" />
                        <TextBlock Text="{loc:T DpNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <DataGrid x:Name="Grid" theming:Empty.Text="{loc:T EmDuplicates}" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                      MouseDoubleClick="Grid_DoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding File.FullPath}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="34" CanUserResize="False" SortMemberPath="Selected">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Named for screen readers; not editable while the grid is read-only (a clean is running). -->
                                <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                          AutomationProperties.Name="{Binding File.FullPath}"
                                          IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource Not}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:T ColName}" Binding="{Binding File.Name}" Width="2*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource PathCell}" />
                    <DataGridTextColumn Header="{loc:T ColFolder}" Binding="{Binding File.Folder}" Width="3*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource PathCell}" />
                    <DataGridTextColumn Header="{loc:T DpColSize}" Binding="{Binding SizeText}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="{loc:T DpColModified}" Binding="{Binding ModifiedText}" Width="140" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
