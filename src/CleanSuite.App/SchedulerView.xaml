<UserControl x:Class="CleanSuite.App.SchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CleanSuite.App.Localization"
             xmlns:theming="clr-namespace:CleanSuite.App.Theming"
             Loaded="View_Loaded">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="GroupName" Value="When" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Word" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Margin="0,0,0,10">
            <WrapPanel>
                <Button x:Name="SaveButton" Content="{loc:T SdSave}" Click="Save_Click" Style="{StaticResource AccentButton}" IsEnabled="False" />
                <Button x:Name="RemoveButton" Content="{loc:T SdRemove}" Click="Remove_Click" IsEnabled="False" />
            </WrapPanel>
        </Border>

        <TextBlock theming:Live.Announce="True" x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="{loc:T SdIntro}" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock Text="{loc:T SdTasksHeader}" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,16">
                    <CheckBox x:Name="TaskJunk" Content="{loc:T TabJunk}" Margin="0,0,20,6" Click="Task_Click" />
                    <CheckBox x:Name="TaskRegistry" Content="{loc:T TabRegistry}" Margin="0,0,20,6" Click="Task_Click" />
                    <CheckBox x:Name="TaskHistory" Content="{loc:T TabHistory}" Margin="0,0,20,6" Click="Task_Click" />
                    <CheckBox x:Name="TaskShortcuts" Content="{loc:T TabShortcuts}" Margin="0,0,20,6" Click="Task_Click" />
                </WrapPanel>

                <TextBlock Text="{loc:T SdWhenHeader}" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                <StackPanel Style="{StaticResource Row}">
                    <RadioButton x:Name="KindOnce" Content="{loc:T SdOnce}" Style="{StaticResource Choice}" Checked="Kind_Checked" />
                    <TextBox x:Name="DateBox" AutomationProperties.Name="{loc:T SdOnce}" Width="110" Style="{StaticResource Number}" ToolTip="{loc:T SdDateTip}"
                             IsEnabled="{Binding IsChecked, ElementName=KindOnce}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                    <RadioButton x:Name="KindDaily" Content="{loc:T SdDaily}" Style="{StaticResource Choice}" Checked="Kind_Checked" />
                    <TextBox x:Name="DaysBox" AutomationProperties.Name="{loc:T SdDays}" Style="{StaticResource Number}" IsEnabled="{Binding IsChecked, ElementName=KindDaily}" />
                    <TextBlock Text="{loc:T SdDays}" Style="{StaticResource Word}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                    <RadioButton x:Name="KindWeekly" Content="{loc:T SdWeekly}" Style="{StaticResource Choice}" Checked="Kind_Checked" />
                    <TextBox x:Name="WeeksBox" AutomationProperties.Name="{loc:T SdWeeksOn}" Style="{StaticResource Number}" IsEnabled="{Binding IsChecked, ElementName=KindWeekly}" />
                    <TextBlock Text="{loc:T SdWeeksOn}" Style="{StaticResource Word}" />
                    <ComboBox x:Name="DayOfWeekCombo" AutomationProperties.Name="{loc:T SdWeeksOn}" Width="130" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=KindWeekly}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                    <RadioButton x:Name="KindMonthly" Content="{loc:T SdMonthly}" Style="{StaticResource Choice}" Checked="Kind_Checked" />
                    <ComboBox x:Name="DayOfMonthCombo" Width="70" Margin="6,0" VerticalAlignment="Center" FlowDirection="LeftToRight"
                              IsEnabled="{Binding IsChecked, ElementName=KindMonthly}" SelectionChanged="DayOfMonth_Changed" />
                    <TextBlock x:Name="MonthNote" Text="{loc:T SdMonthNote}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                    <RadioButton x:Name="KindStartup" Content="{loc:T SdStartup}" Style="{StaticResource Choice}" Checked="Kind_Checked" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                    <RadioButton x:Name="KindLogon" Content="{loc:T SdLogon}" Style="{StaticResource Choice}" Checked="Kind_Checked" />
                </StackPanel>

                <StackPanel x:Name="TimeRow" Style="{StaticResource Row}" Margin="0,4,0,16">
                    <TextBlock Text="{loc:T SdTime}" Style="{StaticResource Word}" MinWidth="164" />
                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="6,0">
                        <ComboBox x:Name="HourCombo" AutomationProperties.Name="{loc:T SdHour}" Width="64" VerticalAlignment="Center" />
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                        <ComboBox x:Name="MinuteCombo" AutomationProperties.Name="{loc:T SdMinute}" Width="64" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="WhatText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
