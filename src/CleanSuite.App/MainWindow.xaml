<Window x:Class="CleanSuite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CleanSuite.App.Localization"
        xmlns:local="clr-namespace:CleanSuite.App"
        xmlns:theming="clr-namespace:CleanSuite.App.Theming"
        Style="{StaticResource AppWindow}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Height="760" Width="1280" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>

    </Window.Resources>

    <theming:NavTabControl x:Name="Tabs" Style="{StaticResource NavTabs}">
        <theming:Nav.Header>
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource AppIcon}" Width="32" Height="32" Margin="0,0,10,0" AutomationProperties.Name="CleanSuite" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CleanSuite" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:T AppTagline}" Style="{StaticResource MutedText}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </theming:Nav.Header>
        <theming:Nav.Footer>
            <!-- Language and theme apply to every page. Language names are shown in their own language on purpose. -->
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LanguageLabel" Grid.Row="0" Text="{loc:T Language}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LanguageCombo" SelectionChanged="Language_Changed"
                              AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}">
                        <ComboBoxItem Content="العربية" Tag="Arabic" />
                        <ComboBoxItem Content="English" Tag="English" />
                    </ComboBox>
                    <TextBlock x:Name="ThemeLabel" Grid.Row="2" Text="{loc:T Theme}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ThemeCombo" SelectionChanged="Theme_Changed"
                              AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}">
                        <ComboBoxItem Content="{loc:T ThemeSystem}" Tag="System" />
                        <ComboBoxItem Content="{loc:T ThemeLight}" Tag="Light" />
                        <ComboBoxItem Content="{loc:T ThemeDark}" Tag="Dark" />
                    </ComboBox>
                </Grid>
                <Button Click="About_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0" AutomationProperties.Name="{loc:T AboutOpen}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Icon.Info}" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T AboutOpen}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </theming:Nav.Footer>

        <TabItem x:Name="HomeItem" Header="{loc:T TabHome}" Tag="{StaticResource Icon.Home}">
            <local:HomeView x:Name="HomeTab" />
        </TabItem>
        <TabItem Style="{StaticResource NavGroup}" Header="{loc:T NavClean}" />
        <TabItem x:Name="JunkItem" Header="{loc:T TabJunk}" Tag="{StaticResource Icon.Junk}">
            <local:JunkView x:Name="JunkTab" />
        </TabItem>
        <TabItem x:Name="HistoryItem" Header="{loc:T TabHistory}" Tag="{StaticResource Icon.History}">
            <local:HistoryView x:Name="HistoryTab" />
        </TabItem>
        <TabItem x:Name="DuplicatesItem" Header="{loc:T TabDuplicates}" Tag="{StaticResource Icon.Duplicates}">
            <local:DuplicatesView x:Name="DuplicatesTab" />
        </TabItem>
        <TabItem x:Name="ShortcutsItem" Header="{loc:T TabShortcuts}" Tag="{StaticResource Icon.Shortcuts}">
            <local:ShortcutsView x:Name="ShortcutsTab" />
        </TabItem>
        <TabItem Style="{StaticResource NavGroup}" Header="{loc:T NavSystem}" />
        <TabItem x:Name="RegistryItem" Header="{loc:T TabRegistry}" Tag="{StaticResource Icon.Registry}">
            <local:RegistryView x:Name="RegistryTab" />
        </TabItem>
        <TabItem x:Name="StartupItem" Header="{loc:T TabStartup}" Tag="{StaticResource Icon.Startup}">
            <local:StartupView x:Name="StartupTab" />
        </TabItem>
        <TabItem x:Name="UninstallItem" Header="{loc:T TabUninstall}" Tag="{StaticResource Icon.Uninstall}">
            <local:UninstallView x:Name="UninstallTab" />
        </TabItem>
        <TabItem Style="{StaticResource NavGroup}" Header="{loc:T NavTools}" />
        <TabItem x:Name="DiskItem" Header="{loc:T TabDisk}" Tag="{StaticResource Icon.Disk}">
            <local:DiskView x:Name="DiskTab" />
        </TabItem>
        <TabItem x:Name="RestoreItem" Header="{loc:T TabRestore}" Tag="{StaticResource Icon.Restore}">
            <local:RestoreView x:Name="RestoreTab" />
        </TabItem>
        <TabItem x:Name="SchedulerItem" Header="{loc:T TabScheduler}" Tag="{StaticResource Icon.Scheduler}">
            <local:SchedulerView x:Name="SchedulerTab" />
        </TabItem>
    </theming:NavTabControl>
</Window>
