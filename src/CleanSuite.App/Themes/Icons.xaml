    <!--
        Outline icon: <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Icon.Junk}" />. The geometry keeps its
        24 × 24 grid (so every icon has the same optical size) and is stroked in the control's Foreground, which is inherited
        from the surrounding text. Icons are pictures, not text, so they are not mirrored in right-to-left layouts, except the
        two that show a direction (the "back in time" arrow of Restore and the outward arrow of Shortcuts), which point the
        way the Arabic layout reads.
    -->
    <Style x:Key="Icon" TargetType="ContentControl">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{StaticResource Icon.Restore}">
                <Setter Property="FlowDirection" Value="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{StaticResource Icon.Shortcuts}">
                <Setter Property="FlowDirection" Value="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
