    <!--
        CleanSuite's own artwork, drawn as vectors (no image files, no emoji).
        AppIconDrawing: the application icon on a 96 × 96 grid (shield with a sweep and a sparkle). The window icon uses it
        directly and "CleanSuite.App.exe - -export-icon <file.ico>" renders it to the .ico embedded in the program.
        Icon.*: outline tool icons on a 24 × 24 grid, drawn with the IconPath style (stroke follows the text colour).
    -->
    <DrawingGroup x:Key="AppIconDrawing">
        <GeometryDrawing Geometry="M0,0 H96 V96 H0 Z" Brush="Transparent" />
        <GeometryDrawing Geometry="M22,4 H74 A18,18 0 0 1 92,22 V74 A18,18 0 0 1 74,92 H22 A18,18 0 0 1 4,74 V22 A18,18 0 0 1 22,4 Z">
            <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF2B8BE6" Offset="0" />
                    <GradientStop Color="#FF0E4E9A" Offset="1" />
                </LinearGradientBrush>
            </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M48,15 L74,25 V45 C74,61 63,73 48,80 C33,73 22,61 22,45 V25 Z" Brush="#FFEAF4FD" />
        <GeometryDrawing Geometry="M48,15 L74,25 V45 C74,61 63,73 48,80 Z" Brush="#FFD3E7FA" />
        <!-- The sweep: a short down stroke and a long rising one, filled so it tapers like a brush stroke. -->
        <GeometryDrawing Geometry="M31.5,47 C33.5,45 36.5,45.6 38.4,48 L44.6,55.8 C51,46 57.5,38.6 64.6,33.2 C66.8,31.6 69.6,33.6 68.3,36.2 C62.2,46.8 55.4,56.2 48.3,64 C46.6,65.9 43.6,65.9 41.9,64 L31.2,52.2 C29.8,50.6 30,48.4 31.5,47 Z" Brush="#FF1462B3" />
        <GeometryDrawing Geometry="M68,9 L71,17 L79,20 L71,23 L68,31 L65,23 L57,20 L65,17 Z" Brush="#FF7FE0C0" />
    </DrawingGroup>
    <DrawingImage x:Key="AppIcon" Drawing="{StaticResource AppIconDrawing}" />

