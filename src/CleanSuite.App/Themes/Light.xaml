<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Every style in Controls.xaml reads these keys through DynamicResource. -->
    <SolidColorBrush x:Key="WindowBg" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SurfaceBg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBg" Color="#FFF7F9FC" />
    <SolidColorBrush x:Key="Stroke" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="TextFg" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="TextMutedFg" Color="#FF616161" />
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBg" Color="#FFF0F4FA" />
    <SolidColorBrush x:Key="ControlPressedBg" Color="#FFE3EAF4" />
    <!-- Control outlines at least 3:1 against the surfaces (WCAG 1.4.11). -->
    <SolidColorBrush x:Key="ControlBorder" Color="#FF8A8A8A" />
    <!-- Empty part of a usage bar: visible on the card, with the accent fill clearly darker or lighter. -->
    <SolidColorBrush x:Key="TrackBg" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="AccentBg" Color="#FF005FB8" />
    <SolidColorBrush x:Key="AccentHoverBg" Color="#FF1A6FC4" />
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SelectionBg" Color="#FFCCE4F7" />
    <SolidColorBrush x:Key="SelectionFg" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="SelectionInactiveBg" Color="#FFE5EEF7" />
    <SolidColorBrush x:Key="HeaderBg" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="GridLine" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#FFB5B5B5" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="DangerFg" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="DisabledFg" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="NavBg" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="ChipSuccessBg" Color="#FFDFF3E6" />
    <SolidColorBrush x:Key="ChipSuccessFg" Color="#FF0E6B3A" />
    <SolidColorBrush x:Key="ChipWarningBg" Color="#FFFCEFD2" />
    <SolidColorBrush x:Key="ChipWarningFg" Color="#FF7A4E00" />
    <SolidColorBrush x:Key="ChipDangerBg" Color="#FFFBE3E3" />
    <SolidColorBrush x:Key="ChipDangerFg" Color="#FF9B1C1C" />
    <SolidColorBrush x:Key="ChipNeutralBg" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="ChipNeutralFg" Color="#FF4F4F4F" />
    <SolidColorBrush x:Key="NavHoverBg" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="NavSelectedBg" Color="#FFFFFFFF" />
</ResourceDictionary>
