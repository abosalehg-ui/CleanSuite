<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Every style in Controls.xaml reads these keys through DynamicResource. -->
    <SolidColorBrush x:Key="WindowBg" Color="#FF202020" />
    <SolidColorBrush x:Key="SurfaceBg" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="SurfaceAltBg" Color="#FF303030" />
    <SolidColorBrush x:Key="Stroke" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="TextFg" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="TextMutedFg" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="ControlBg" Color="#FF353535" />
    <SolidColorBrush x:Key="ControlHoverBg" Color="#FF404040" />
    <SolidColorBrush x:Key="ControlPressedBg" Color="#FF2E2E2E" />
    <!-- Control outlines at least 3:1 against the surfaces (WCAG 1.4.11). -->
    <SolidColorBrush x:Key="ControlBorder" Color="#FF7A7A7A" />
    <!-- Empty part of a usage bar: visible on the card, with the accent fill clearly darker or lighter. -->
    <SolidColorBrush x:Key="TrackBg" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="AccentBg" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBg" Color="#FF6BCDFF" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF000000" />
    <SolidColorBrush x:Key="SelectionBg" Color="#FF1F4A6E" />
    <SolidColorBrush x:Key="SelectionFg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SelectionInactiveBg" Color="#FF33404B" />
    <SolidColorBrush x:Key="HeaderBg" Color="#FF262626" />
    <SolidColorBrush x:Key="GridLine" Color="#FF363636" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="DangerFg" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="DisabledFg" Color="#FF6E6E6E" />
    <SolidColorBrush x:Key="NavBg" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="ChipSuccessBg" Color="#FF1E3B2C" />
    <SolidColorBrush x:Key="ChipSuccessFg" Color="#FF8FE0B0" />
    <SolidColorBrush x:Key="ChipWarningBg" Color="#FF43361A" />
    <SolidColorBrush x:Key="ChipWarningFg" Color="#FFF5CF7A" />
    <SolidColorBrush x:Key="ChipDangerBg" Color="#FF4A2328" />
    <SolidColorBrush x:Key="ChipDangerFg" Color="#FFFFA9B2" />
    <SolidColorBrush x:Key="ChipNeutralBg" Color="#FF383838" />
    <SolidColorBrush x:Key="ChipNeutralFg" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="NavHoverBg" Color="#FF262626" />
    <SolidColorBrush x:Key="NavSelectedBg" Color="#FF2E2E2E" />
</ResourceDictionary>
