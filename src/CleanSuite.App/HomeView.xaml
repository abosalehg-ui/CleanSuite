<UserControl x:Class="CleanSuite.App.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CleanSuite.App.Localization"
             IsVisibleChanged="View_IsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardIcon" TargetType="ContentControl" BasedOn="{StaticResource Icon}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBg}" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="200" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,2,0,18">
                <Image Source="{StaticResource AppIcon}" Width="52" Height="52" Margin="0,0,14,0" AutomationProperties.Name="CleanSuite" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T HmWelcome}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:T HmSubtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <UniformGrid Columns="2">
                <!-- Drives -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ContentControl Style="{StaticResource CardIcon}" Tag="{StaticResource Icon.Drive}" />
                            <TextBlock Text="{loc:T HmDrives}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <ItemsControl x:Name="DriveList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FreeText}" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                        </DockPanel>
                                        <Grid Height="6" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding UsedWidth}" />
                                                <ColumnDefinition Width="{Binding FreeWidth}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource TrackBg}" />
                                            <Border Grid.Column="0" CornerRadius="3" Background="{Binding Bar}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:T TabDisk}" Click="Go_Click" Tag="disk" HorizontalAlignment="Left" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Backups -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ContentControl Style="{StaticResource CardIcon}" Tag="{StaticResource Icon.Backup}" />
                            <TextBlock Text="{loc:T HmBackups}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="BackupText" TextWrapping="Wrap" />
                        <TextBlock x:Name="BackupCount" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="{loc:T HmBackupNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Button Content="{loc:T TabRestore}" Click="Go_Click" Tag="restore" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Scheduled cleanup -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ContentControl Style="{StaticResource CardIcon}" Tag="{StaticResource Icon.Clock}" />
                            <TextBlock Text="{loc:T HmSchedule}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="ScheduleText" TextWrapping="Wrap" />
                        <TextBlock x:Name="LastRunText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <Button Content="{loc:T TabScheduler}" Click="Go_Click" Tag="scheduler" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Quick start: opens a tool; nothing is scanned or removed from here. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ContentControl Style="{StaticResource CardIcon}" Tag="{StaticResource Icon.Shield}" />
                            <TextBlock Text="{loc:T HmQuick}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource QuickButton}" Click="Go_Click" Tag="junk" AutomationProperties.Name="{loc:T TabJunk}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Icon.Junk}" Margin="0,0,10,0" />
                                    <TextBlock Text="{loc:T TabJunk}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickButton}" Click="Go_Click" Tag="registry" AutomationProperties.Name="{loc:T TabRegistry}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Icon.Registry}" Margin="0,0,10,0" />
                                    <TextBlock Text="{loc:T TabRegistry}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickButton}" Click="Go_Click" Tag="history" AutomationProperties.Name="{loc:T TabHistory}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Icon.History}" Margin="0,0,10,0" />
                                    <TextBlock Text="{loc:T TabHistory}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickButton}" Click="Go_Click" Tag="startup" AutomationProperties.Name="{loc:T TabStartup}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Icon.Startup}" Margin="0,0,10,0" />
                                    <TextBlock Text="{loc:T TabStartup}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{loc:T HmQuickNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
