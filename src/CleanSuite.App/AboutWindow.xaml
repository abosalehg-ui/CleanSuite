<Window x:Class="CleanSuite.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CleanSuite.App.Localization"
        xmlns:local="clr-namespace:CleanSuite.App"
        Style="{StaticResource AppWindow}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Title="{loc:T AboutOpen}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="{StaticResource AppIcon}" Width="72" Height="72" Margin="0,0,16,0" AutomationProperties.Name="CleanSuite" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CleanSuite" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{loc:T AboutText}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="{loc:T AboutLicense}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,20" />
        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{loc:T AboutDeveloper}" Click="Developer_Click" Margin="0"
                    ToolTip="{x:Static local:AboutWindow.DeveloperPage}" />
            <Button DockPanel.Dock="Right" Content="{loc:T Close}" Click="Close_Click" IsDefault="True" IsCancel="True" Margin="0"
                    Style="{StaticResource AccentButton}" />
        </DockPanel>
    </StackPanel>
</Window>
