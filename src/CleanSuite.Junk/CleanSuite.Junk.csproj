<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CleanSuite.Matching\CleanSuite.Matching.csproj" />
    <ProjectReference Include="..\CleanSuite.Safety\CleanSuite.Safety.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CleanSuite's own junk protection list, inside the program so it applies on every computer (IgnoreList.BuiltIn). -->
    <EmbeddedResource Include="IgnoreLists\CleanSuite.txt" LogicalName="CleanSuite.Junk.IgnoreLists.CleanSuite.txt" />
  </ItemGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
