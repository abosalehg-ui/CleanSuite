<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage for "dotnet test -s coverage.runsettings": every CleanSuite assembly, the desktop program included. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[CleanSuite.*]*</Include>
          <Exclude>[CleanSuite.Tests]*</Exclude>
          <!-- Generated by the XAML compiler (InitializeComponent, connection ids): not code anyone wrote. -->
          <ExcludeByFile>**/obj/**/*.g.cs,**/obj/**/*.g.i.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
